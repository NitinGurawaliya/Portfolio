generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   Int               @id @default(autoincrement())
  name                 String
  email                String            @unique
  avatarUrl            String?
  bio                  String?
  company              String?
  websiteUrl           String?
  location             String?
  followers            Int?
  following            Int?
  publicRepos          Int?
  twitterUsername      String?
  githubId             String?           @unique
  githubUsername       String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  repositories         Repository[]
  portfolio            Portfolio?
  customDomains        CustomDomain[]
  projectUpvotes       ProjectUpvote[]
  shiplogs             Shiplog[]
  shiplogReactions     ShiplogReaction[]
  followingConnections UserFollow[]      @relation("userFollows")
  followerConnections  UserFollow[]      @relation("userFollowed")

  // Index for fast portfolio lookup by githubUsername
  @@index([githubUsername])
}

model Repository {
  id                    Int                   @id @default(autoincrement())
  githubId              BigInt                @unique
  name                  String
  fullName              String
  description           String?
  htmlUrl               String
  cloneUrl              String
  language              String?
  stargazersCount       Int
  forksCount            Int
  size                  Int
  isPrivate             Boolean
  isFork                Boolean
  createdAt             DateTime
  updatedAt             DateTime
  pushedAt              DateTime?
  userId                Int
  author                String?
  favicon               String?
  isImported            Boolean               @default(false)
  keywords              String?
  siteName              String?
  githubUrl             String?
  languages             String?
  logo                  String?
  portfolioRepositories PortfolioRepository[]
  user                  User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Portfolio {
  id                Int                   @id @default(autoincrement())
  userId            Int                   @unique
  displayName       String?
  jobTitle          String?
  bio               String?
  profilePic        String?
  customUsername    String?
  isPublished       Boolean               @default(false)
  selectedTheme     String                @default("dark") // Theme identifier (dark, light)
  themeConfig       Json? // Custom theme overrides (colors, fonts, etc.)
  backgroundColor   String? // Background color customization
  backgroundPattern String? // Background pattern option
  cvUrl             String? // CV/Resume download URL
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  user              User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  repositories      PortfolioRepository[]
  skills            Skill[]
  socials           Social[]
  experiences       Experience[]
  customDomain      CustomDomain?

  // Indexes for fast public portfolio lookups
  @@index([customUsername])
  @@index([isPublished])
  @@index([customUsername, isPublished]) // Composite index for common query pattern
}

model Skill {
  id          Int       @id @default(autoincrement())
  name        String
  category    String?
  portfolioId Int
  createdAt   DateTime  @default(now())
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
}

model Social {
  id          Int       @id @default(autoincrement())
  portfolioId Int
  platform    String
  username    String
  url         String?
  isPinned    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@unique([portfolioId, platform])
}

model PortfolioRepository {
  id                Int             @id @default(autoincrement())
  portfolioId       Int
  repositoryId      Int
  deployedUrl       String?
  isVisible         Boolean         @default(true)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @default(now()) @updatedAt
  deletedAt         DateTime? // Soft delete to preserve analytics integrity
  displayOrder      Int?
  customName        String?
  customDescription String?
  technologies      String?
  projectCategory   String?
  projectStatus     String?         @default("building")
  projectRevenue    Int?
  projectMrr        Int?
  projectUsers      Int?
  portfolio         Portfolio       @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  repository        Repository      @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  upvotes           ProjectUpvote[]
  shiplogs          Shiplog[]

  @@index([portfolioId, isVisible])
}

model PortfolioView {
  id          Int      @id @default(autoincrement())
  portfolioId Int
  userId      Int
  viewedAt    DateTime @default(now())
  ipAddress   String?
  userAgent   String?
  referrer    String?
  device      String?
  browser     String?

  @@index([portfolioId])
  @@index([userId])
  @@index([viewedAt])
  @@index([device])
  @@index([browser])
}

model PortfolioAnalytics {
  id           Int       @id @default(autoincrement())
  portfolioId  Int       @unique
  totalViews   Int       @default(0)
  lastViewedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now()) @updatedAt

  @@index([portfolioId])
}

model ProjectClick {
  id          Int      @id @default(autoincrement())
  portfolioId Int
  projectId   BigInt
  projectName String
  clickedAt   DateTime @default(now())
  ipAddress   String?
  userAgent   String?
  referrer    String?

  @@index([portfolioId])
  @@index([projectId])
  @@index([clickedAt])
}

model SocialClick {
  id          Int      @id @default(autoincrement())
  portfolioId Int
  socialType  String // 'github', 'linkedin', 'twitter', etc.
  socialUrl   String
  clickedAt   DateTime @default(now())
  ipAddress   String?
  userAgent   String?
  referrer    String?

  @@index([portfolioId])
  @@index([socialType])
  @@index([clickedAt])
}

model PortfolioSession {
  id          Int       @id @default(autoincrement())
  portfolioId Int
  sessionId   String    @unique
  startTime   DateTime  @default(now())
  endTime     DateTime?
  timeSpent   Int? // in seconds
  ipAddress   String?
  userAgent   String?
  referrer    String?

  @@index([portfolioId])
  @@index([sessionId])
  @@index([startTime])
}

model ProjectView {
  id          Int      @id @default(autoincrement())
  portfolioId Int
  projectId   BigInt
  projectName String
  viewedAt    DateTime @default(now())
  ipAddress   String?
  userAgent   String?
  referrer    String?

  @@index([portfolioId])
  @@index([projectId])
  @@index([viewedAt])
}

model DailyProjectViews {
  id          Int      @id @default(autoincrement())
  portfolioId Int
  projectId   BigInt // PortfolioRepository ID
  projectName String
  date        DateTime @db.Date
  views       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([portfolioId, projectId, date])
  @@index([portfolioId])
  @@index([projectId])
  @@index([date])
  @@index([portfolioId, projectId]) // Composite index for faster lookups
}

model ProjectUpvote {
  id                    Int                 @id @default(autoincrement())
  userId                Int
  portfolioRepositoryId Int
  createdAt             DateTime            @default(now())
  user                  User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  portfolioRepository   PortfolioRepository @relation(fields: [portfolioRepositoryId], references: [id], onDelete: Cascade)

  @@unique([userId, portfolioRepositoryId])
  @@index([portfolioRepositoryId])
}

model Experience {
  id          Int       @id @default(autoincrement())
  portfolioId Int
  companyName String
  companyUrl  String?
  faviconUrl  String?
  role        String? // SDE, SDE2, etc.
  duration    String? // e.g., May 2023 - May 2024
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@index([portfolioId])
}

model Shiplog {
  id                    Int                  @id @default(autoincrement())
  userId                Int
  portfolioRepositoryId Int?
  content               String               @db.Text
  imageUrl              String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  author                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  project               PortfolioRepository? @relation(fields: [portfolioRepositoryId], references: [id], onDelete: SetNull)
  reactions             ShiplogReaction[]

  @@index([userId])
  @@index([portfolioRepositoryId])
  @@index([createdAt])
}

model ShiplogReaction {
  id        Int                 @id @default(autoincrement())
  shiplogId Int
  userId    Int
  type      ShiplogReactionType
  createdAt DateTime            @default(now())
  shiplog   Shiplog             @relation(fields: [shiplogId], references: [id], onDelete: Cascade)
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([shiplogId, userId])
  @@index([shiplogId])
  @@index([userId])
}

model CustomDomain {
  id          String    @id @default(cuid())
  domain      String    @unique
  portfolioId Int       @unique // One domain per portfolio
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  userId      Int
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Verification
  verified          Boolean @default(false)
  verificationToken String // For TXT record

  // Metadata
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastCheckedAt DateTime?

  @@index([userId])
  @@index([domain])
  @@index([verified])
}

model UserFollow {
  id          Int      @id @default(autoincrement())
  followerId  Int
  followingId Int
  createdAt   DateTime @default(now())
  follower    User     @relation("userFollows", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("userFollowed", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

enum ShiplogReactionType {
  SHIPPED
  FIXED
  SUPPORT
}
