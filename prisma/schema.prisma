generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              Int          @id @default(autoincrement())
  name            String
  email           String       @unique
  avatarUrl       String?
  bio             String?
  company         String?
  createdAt       DateTime     @default(now())
  followers       Int?
  following       Int?
  githubId        String?      @unique
  githubUsername  String?
  location        String?
  publicRepos     Int?
  twitterUsername String?
  updatedAt       DateTime     @updatedAt
  websiteUrl      String?
  portfolio       Portfolio?
  repositories    Repository[]
}

model Repository {
  id                    Int                   @id @default(autoincrement())
  githubId              BigInt                @unique
  name                  String
  fullName              String
  description           String?
  htmlUrl               String
  cloneUrl              String
  language              String?
  stargazersCount       Int
  forksCount            Int
  size                  Int
  isPrivate             Boolean
  isFork                Boolean
  createdAt             DateTime
  updatedAt             DateTime
  pushedAt              DateTime?
  userId                Int
  author                String?
  favicon               String?
  isImported            Boolean               @default(false)
  keywords              String?
  siteName              String?
  githubUrl             String?
  languages             String?
  logo                  String?
  portfolioRepositories PortfolioRepository[]
  user                  User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Portfolio {
  id             Int                   @id @default(autoincrement())
  userId         Int                   @unique
  displayName    String?
  bio            String?
  profilePic     String?
  isPublished    Boolean               @default(false)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  customUsername String?
  jobTitle       String?
  selectedTheme  String                @default("dark")
  themeConfig    Json?
  user           User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  repositories   PortfolioRepository[]
  skills         Skill[]
  socials        Social[]
}

model Skill {
  id          Int       @id @default(autoincrement())
  name        String
  category    String?
  portfolioId Int
  createdAt   DateTime  @default(now())
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
}

model Social {
  id          Int       @id @default(autoincrement())
  portfolioId Int
  platform    String
  username    String
  url         String?
  isPinned    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@unique([portfolioId, platform])
}

model PortfolioRepository {
  id                Int        @id @default(autoincrement())
  portfolioId       Int
  repositoryId      Int
  deployedUrl       String?
  isVisible         Boolean    @default(true)
  createdAt         DateTime   @default(now())
  displayOrder      Int?
  customName        String?
  customDescription String?
  technologies      String?
  portfolio         Portfolio  @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  repository        Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
}

model PortfolioView {
  id          Int      @id @default(autoincrement())
  portfolioId Int
  userId      Int
  viewedAt    DateTime @default(now())
  ipAddress   String?
  userAgent   String?
  referrer    String?

  @@index([portfolioId])
  @@index([userId])
  @@index([viewedAt])
}

model PortfolioAnalytics {
  id           Int       @id @default(autoincrement())
  portfolioId  Int       @unique
  totalViews   Int       @default(0)
  lastViewedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now()) @updatedAt

  @@index([portfolioId])
}

model ProjectClick {
  id          Int      @id @default(autoincrement())
  portfolioId Int
  projectId   BigInt
  projectName String
  clickedAt   DateTime @default(now())
  ipAddress   String?
  userAgent   String?
  referrer    String?

  @@index([portfolioId])
  @@index([projectId])
  @@index([clickedAt])
}

model SocialClick {
  id          Int      @id @default(autoincrement())
  portfolioId Int
  socialType  String   // 'github', 'linkedin', 'twitter', etc.
  socialUrl   String
  clickedAt   DateTime @default(now())
  ipAddress   String?
  userAgent   String?
  referrer    String?

  @@index([portfolioId])
  @@index([socialType])
  @@index([clickedAt])
}

model PortfolioSession {
  id          Int      @id @default(autoincrement())
  portfolioId Int
  sessionId   String   @unique
  startTime   DateTime @default(now())
  endTime     DateTime?
  timeSpent   Int?     // in seconds
  ipAddress   String?
  userAgent   String?
  referrer    String?

  @@index([portfolioId])
  @@index([sessionId])
  @@index([startTime])
}

model ProjectView {
  id          Int      @id @default(autoincrement())
  portfolioId Int
  projectId   BigInt
  projectName String
  viewedAt    DateTime @default(now())
  ipAddress   String?
  userAgent   String?
  referrer    String?

  @@index([portfolioId])
  @@index([projectId])
  @@index([viewedAt])
}

model DailyProjectViews {
  id          Int      @id @default(autoincrement())
  portfolioId Int
  projectId   BigInt
  projectName String
  date        DateTime @db.Date
  views       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([portfolioId, projectId, date])
  @@index([portfolioId])
  @@index([projectId])
  @@index([date])
}