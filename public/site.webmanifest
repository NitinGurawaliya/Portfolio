    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "/devfolio-high-resolution-logo.png",
      "sizes": "any",
      "type": "image/png"
    }
  ]
}
